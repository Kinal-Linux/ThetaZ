LONG WINAPI_CALL THETAZ_VariantClear(void* pvarg) {
    if (!pvarg) return 0x80000005; // E_FAIL
    uint8_t* b = static_cast<uint8_t*>(pvarg);
    DWORD vt = 0;
    memcpy(&vt, b, 4);
    if (vt == VT_BSTR) {
        BSTR s = nullptr;
        memcpy(&s, b + 8, sizeof(BSTR));
        free_bstr(s);
    }
    memset(b, 0, 16);
    return 0; // S_OK
}

