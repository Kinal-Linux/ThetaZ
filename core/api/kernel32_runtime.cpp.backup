        std::lock_guard<std::mutex> lock(g_window_mutex);
        g_dialog_result_active = true;
        g_dialog_result = result;
        auto xit = g_x11_windows.find(h);
        if (xit != g_x11_windows.end()) {
            g_x11_hwnds.erase(xit->second);
            g_x11_windows.erase(xit);
        }
        g_windows.erase(h);
    }
    return TRUE_VALUE;
}

