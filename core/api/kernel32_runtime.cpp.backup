int WINAPI_CALL THETAZ_PathParseIconLocationW(LPWSTR pszIconPath) {
    (void)pszIconPath;
    return 0;
}

void WINAPI_CALL THETAZ_PathQuoteSpacesW(LPWSTR lpsz) {
    (void)lpsz;
}

BOOL WINAPI_CALL THETAZ_PathRelativePathToW(LPWSTR pszPath, LPCWSTR pszFrom, DWORD dwAttrFrom, LPCWSTR pszTo, DWORD dwAttrTo) {
    (void)pszPath; (void)pszFrom; (void)dwAttrFrom; (void)pszTo; (void)dwAttrTo;
    return FALSE;
}

void WINAPI_CALL THETAZ_PathRemoveBackslashW(LPWSTR lpsz) {
    if (lpsz) {
        int l = wcslen(lpsz);
        if (l > 0 && lpsz[l-1] == L'\\') lpsz[l-1] = L'\0';
    }
}

void WINAPI_CALL THETAZ_PathRemoveBlanksW(LPWSTR lpsz) {
    (void)lpsz;
}

void WINAPI_CALL THETAZ_PathRemoveExtensionW(LPWSTR lpsz) {
    if (lpsz) {
        wchar_t* dot = wcsrchr(lpsz, L'.');
        if (dot && dot > wcsrchr(lpsz, L'\\')) *dot = L'\0';
    }
}

BOOL WINAPI_CALL THETAZ_PathRemoveFileSpecW(LPWSTR lpsz) {
    if (lpsz) {
        wchar_t* s = wcsrchr(lpsz, L'\\');
        if (!s) s = wcsrchr(lpsz, L'/');
        if (s) *s = L'\0';
    }
    return TRUE;
}

BOOL WINAPI_CALL THETAZ_PathRenameExtensionW(LPWSTR lpsz, LPCWSTR pszExt) {
    (void)lpsz; (void)pszExt;
    return FALSE;
}

BOOL WINAPI_CALL THETAZ_PathSkipRootW(LPWSTR p) {
    if (!p) return FALSE;
    if (p[0] == L'\\' && p[1] == L'\\') {
        wchar_t* s = p + 2;
        while (*s && *s != L'\\') s++;
        if (*s) s++;
        while (*s && *s != L'\\') s++;
        wcscpy(p, s);
        return TRUE;
    }
    if (p[1] == L':') {
        wcscpy(p, p + 3);
        return TRUE;
    }
    return FALSE;
}

void WINAPI_CALL THETAZ_PathStripPathW(LPWSTR p) {
    if (p) {
        wchar_t* n = THETAZ_PathFindFileNameW(p);
        if (n != p) wcscpy(p, n);
    }
}

BOOL WINAPI_CALL THETAZ_PathStripToRootW(LPWSTR p) {
    if (!p) return FALSE;
    if (p[1] == L':') {
        p[2] = L'\\';
        p[3] = L'\0';
        return TRUE;
    }
    if (p[0] == L'\\' && p[1] == L'\\') {
        p[2] = L'\0';
        return TRUE;
    }
    return FALSE;
}

BOOL WINAPI_CALL THETAZ_PathUnExpandEnvStringsW(LPCWSTR pszSrc, LPWSTR pszDst, UINT cchDst) {
    if (pszDst && pszSrc && cchDst) {
        wcsncpy(pszDst, pszSrc, cchDst);
        return TRUE;
    }
    return FALSE;
}

void WINAPI_CALL THETAZ_PathUnquoteSpacesW(LPWSTR lpsz) {
    (void)lpsz;
}

